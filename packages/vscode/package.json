{
  "name": "squiggle-vscode",
  "displayName": "Squiggle",
  "description": "Explains errors in plain language.",
  "version": "0.1.0",
  "publisher": "varvarakarenski",
  "license": "MIT",
  "icon": "media/logo.png",
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "keywords": [
    "errors",
    "explain",
    "beginner",
    "python",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/varvarakarenski/squiggle"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "squiggle",
          "title": "Squiggle",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "squiggle": [
        {
          "type": "webview",
          "id": "squiggle.panel",
          "name": "Explanations"
        }
      ]
    },
    "commands": [
      {
        "command": "squiggle.playSamples",
        "title": "Play Sample Explanations",
        "category": "Squiggle",
        "icon": "$(play)"
      },
      {
        "command": "squiggle.showWelcome",
        "title": "Open Settings",
        "category": "Squiggle",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "squiggle.showWelcome",
          "when": "view == squiggle.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Squiggle",
      "properties": {
        "squiggle.patience": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "default": 1500,
          "markdownDescription": "How long to wait for an error to stop changing before explaining it, in milliseconds. Errors flicker while you type, so a little patience avoids noise. **Instant** is 0; **Deep zen** is 5s."
        },
        "squiggle.narration": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 33,
          "markdownDescription": "How much hand-holding in explanations, from **Pro** (0 — terse: what it means and the fix) to **Baby** (100 — spells everything out, with reassurance)."
        },
        "squiggle.contextLines": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "default": 10,
          "markdownDescription": "How many lines of surrounding code are sent along with an error to make the explanation better. 0 sends just the error line — nothing extra leaves your computer."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.106.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
